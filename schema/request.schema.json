{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qperf/request/1",
  "title": "qperf analyze request",
  "type": "object",
  "required": [
    "schema_version",
    "action",
    "workload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "estimate",
        "compare",
        "tune",
        "sensitivity",
        "survey"
      ]
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string",
          "description": "name or name@revision, e.g. quasar@2026-11-02.1"
        },
        "kernel": {
          "type": "string",
          "description": "e.g. binary-ng-native@c86eb2dc690"
        },
        "costs": {
          "type": "string",
          "description": "platform the times describe: ttsim-perf | craq-sim | silicon-hypothesis"
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "description": "add | multiply (binary_ng) | tilize | untilize | tilize_with_val_padding | untilize_with_unpadding | interleaved_to_sharded | sharded_to_interleaved | move | reshard"
        },
        "kernel_variant": {
          "type": "string",
          "enum": [
            "fpu",
            "sfpu"
          ],
          "description": "only when the op's routing is not in the kernel profile; take it from the program log"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "bf16",
            "fp32"
          ]
        },
        "num_tiles": {
          "type": "integer",
          "minimum": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "layout ops: [..., H, W], the logical (unpadded) tensor; leading dims fold into rows"
        },
        "tiles_scope": {
          "type": "string",
          "enum": [
            "operation",
            "cluster"
          ]
        },
        "clusters": {
          "type": "integer",
          "minimum": 1
        },
        "placements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "string",
              "enum": [
                "dram",
                "l1",
                "borrowed"
              ]
            },
            "b": {
              "type": "string",
              "enum": [
                "dram",
                "l1",
                "borrowed"
              ]
            },
            "out": {
              "type": "string",
              "enum": [
                "dram",
                "l1",
                "borrowed"
              ]
            }
          }
        },
        "shard": {
          "type": "object",
          "additionalProperties": false,
          "description": "interleaved_to_sharded / sharded_to_interleaved: the L1 shard layout (even shards)",
          "properties": {
            "strategy": {
              "enum": [
                "height",
                "width",
                "block"
              ]
            },
            "cores": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "layout": {
          "enum": [
            "tile",
            "row_major"
          ],
          "description": "interleaved_to_sharded / sharded_to_interleaved move and reshard: tensor layout (default tile). Sharding ops, row_major: sticks, shard ceil(H/n) x W, H x ceil(W/n) rounded up to 16 B, or ceil(H/k) x ceil(W/k), the last shard may be partial"
        },
        "output": {
          "enum": [
            "overlap",
            "separate"
          ],
          "description": "move: where the output lands relative to the input (default overlap; separate = MoveProgramFactory, which Quasar rejects)"
        },
        "reshard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "description": "reshard: the input and output shard specs",
          "properties": {
            "layout": {
              "enum": [
                "tile",
                "row_major"
              ]
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "height",
                    "width",
                    "block"
                  ]
                },
                "cores": {
                  "type": "integer",
                  "minimum": 1
                },
                "grid": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[rows, cols] of the core grid (block sharding)"
                },
                "memory": {
                  "enum": [
                    "l1",
                    "dram"
                  ]
                }
              }
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "height",
                    "width",
                    "block"
                  ]
                },
                "cores": {
                  "type": "integer",
                  "minimum": 1
                },
                "grid": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[rows, cols] of the core grid (block sharding)"
                },
                "memory": {
                  "enum": [
                    "l1",
                    "dram"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/knobs"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "overrides"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "overrides": {
            "$ref": "#/$defs/knobs"
          }
        }
      }
    },
    "what_if": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute_service_scale": {
          "type": "number",
          "minimum": 0
        },
        "cost_overrides": {
          "type": "object",
          "description": "cost key -> number or {value, low, high}; keys as in the cost profile"
        }
      }
    },
    "tune": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "type": "object",
          "description": "knob -> list of values (null = rule); may include \"barriers\"/\"work_split\" variants. tilize/untilize: the layout design knobs (cores, split, tiles_per_block incl. \"half\", dfb_blocks, write_batch | read_batch); knobs left out take the built-in default space"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "required": [
        "param",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "param": {
          "type": "string",
          "description": "a cost key (e.g. noc.read_latency), compute_service_scale or num_tiles; tilize/untilize: num_rows | num_cols"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "description": "action survey (tilize / untilize): the shape grid; every approach (candidates, or the built-in default policies) is timed at every [H, W] against the baseline. H = rows = prod(shape[:-1]); workload.shape is not needed",
      "properties": {
        "heights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "default [32, 64, 128, ..., 8192]"
        },
        "widths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "default [64, 128, ..., 2048]"
        },
        "compare_profile": {
          "type": "string",
          "description": "also run the survey on this cost profile (e.g. craq-sim next to ttsim-perf) and report every approach's speedup on both (survey.compare)"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "enum": [
            "latency"
          ]
        },
        "detail": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "time_budget_ms": {
          "type": "integer",
          "minimum": 1
        },
        "time_budget_s": {
          "type": "number",
          "minimum": 0,
          "description": "survey: stop after this many seconds (default 30) with status partial"
        }
      }
    },
    "hypothetical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knob_limits": {
          "type": "object",
          "description": "override TTNN_QSR knob ceilings to model a factory change, e.g. {\"dm_batch\": 64}"
        }
      }
    }
  },
  "$defs": {
    "knobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reader_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "compute_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "writer_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "dm_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "tiles_per_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "entries_per_thread": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "dram_batch": {
          "type": "boolean"
        },
        "barriers": {
          "enum": [
            "cluster",
            "per_thread"
          ],
          "description": "hypothetical: per_thread = transaction-ID barriers (default cluster, as in the kernels)"
        },
        "work_split": {
          "enum": [
            "static",
            "dynamic"
          ],
          "description": "hypothetical: dynamic = DM threads claim batches from a shared queue (default static)"
        },
        "use_multicore": {
          "type": "boolean",
          "description": "tilize/untilize: use_multicore (default true)"
        },
        "input": {
          "enum": [
            "dram",
            "l1",
            "borrowed"
          ],
          "description": "tilize/untilize: the tensor's memory (borrowed = height-sharded L1)"
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "hypothetical, tilize Default / untilize MultiCore: at most this many cores share the work (default: the factory's min(32, tile-rows))"
        },
        "split": {
          "enum": [
            "rows",
            "cols",
            "2d"
          ],
          "description": "hypothetical: rows = whole tile-rows per core (factory); cols = each tile-row cut into cores // row-cores column chunks; 2d = row-cores x column chunks <= cores with the fewest tiles per core"
        },
        "tiles_per_block": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "description": "hypothetical: block width in tiles within a core's chunk (default the whole chunk; snapped to a divisor of it). or \"half\" = half the chunk (also in tune.space)"
        },
        "dfb_blocks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "hypothetical: DFB capacity in blocks (default: tilize 1, untilize 2 with more than one block per core)"
        },
        "write_batch": {
          "type": "integer",
          "minimum": 1,
          "description": "hypothetical, tilize: tiles per writer barrier (default 1, the kernel's per-tile flush)"
        },
        "read_batch": {
          "type": "integer",
          "minimum": 1,
          "description": "hypothetical, untilize: tiles per reader barrier (default 1, the kernel's per-tile barrier)"
        },
        "shard_strategy": {
          "enum": [
            "height",
            "width",
            "block"
          ],
          "description": "sharding ops: override workload.shard.strategy"
        },
        "shard_cores": {
          "type": "integer",
          "minimum": 1,
          "description": "sharding ops: override workload.shard.cores"
        },
        "reshard": {
          "type": "object",
          "additionalProperties": false,
          "description": "reshard: replaces workload.reshard's layout / from / to (compare candidates)",
          "properties": {
            "layout": {
              "enum": [
                "tile",
                "row_major"
              ]
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "height",
                    "width",
                    "block"
                  ]
                },
                "cores": {
                  "type": "integer",
                  "minimum": 1
                },
                "grid": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[rows, cols] of the core grid (block sharding)"
                },
                "memory": {
                  "enum": [
                    "l1",
                    "dram"
                  ]
                }
              }
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy"
              ],
              "properties": {
                "strategy": {
                  "enum": [
                    "height",
                    "width",
                    "block"
                  ]
                },
                "cores": {
                  "type": "integer",
                  "minimum": 1
                },
                "grid": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[rows, cols] of the core grid (block sharding)"
                },
                "memory": {
                  "enum": [
                    "l1",
                    "dram"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
