{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qperf/response/1",
  "title": "qperf analyze response",
  "description": "Every response has schema_version, engine_version, status, result_kind and runtime_ms. status ok|partial carry results; needs_input|invalid|unsupported carry a message (and, for an invalid baseline, the evaluated baseline with its errors). partial = a search or sweep stopped early (budget, max_candidates): results are real but not exhaustive.",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "status",
    "result_kind",
    "runtime_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "engine_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "needs_input",
        "invalid",
        "unsupported"
      ]
    },
    "result_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "finite_buffer_estimate",
        null
      ]
    },
    "message": {
      "type": "string"
    },
    "runtime_ms": {
      "type": "number"
    },
    "cache_hits": {
      "type": "integer"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "kernel",
        "costs"
      ],
      "properties": {
        "architecture": {
          "$ref": "#/$defs/profile_id"
        },
        "kernel": {
          "$ref": "#/$defs/profile_id"
        },
        "costs": {
          "$ref": "#/$defs/profile_id"
        }
      }
    },
    "applied_defaults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_unit": {
      "type": "string",
      "enum": [
        "cycles",
        "ns"
      ],
      "description": "what every time_ns value of this response is: cycles = simulator cycles reported as ns by the 1 cycle = 1 ns convention (craq-sim, ttsim-perf); ns = real nanoseconds at the profile's clock (silicon-hypothesis). Field names keep _ns either way"
    },
    "platform_scope": {
      "type": "string"
    },
    "accuracy": {
      "type": "string",
      "description": "how close the model is for THIS op and factory on this profile: binary_ng the mean errors of docs/CALIBRATION.md; data-movement ops the factory's mean error over the profile's calibration runs (profiles/accuracy.json); a hypothetical setup or a derived profile (silicon-hypothesis) says it has no measurement. platform_scope describes the simulator, not the op's error"
    },
    "hypothetical": {
      "type": "object"
    },
    "baseline": {
      "$ref": "#/$defs/result"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "top": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "speedup_range": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "speedup_nominal": {
            "type": "number"
          },
          "bottleneck_after": {
            "type": "string"
          }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exhaustive"
      ],
      "properties": {
        "enumerated": {
          "type": "integer"
        },
        "invalid": {
          "type": "integer"
        },
        "valid": {
          "type": "integer"
        },
        "considered": {
          "type": "integer"
        },
        "evaluated": {
          "type": "integer"
        },
        "truncated_by_max_candidates": {
          "type": "boolean"
        },
        "out_of_time": {
          "type": "boolean"
        },
        "exhaustive": {
          "type": "boolean"
        },
        "evaluated_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "string"
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "param",
        "series"
      ],
      "properties": {
        "param": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "series": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "valid"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "time_ns": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "bottleneck": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "ranking_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "between": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "param": {
                "type": "string"
              },
              "at_about": {
                "type": "number"
              }
            }
          }
        },
        "bottleneck_shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "config": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "at_about": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "description": "action survey: every approach timed at every [H, W] of the grid against the baseline (kernel changes for tilize / untilize, layout choices for the sharding ops and reshard)",
      "required": [
        "heights",
        "widths",
        "skipped",
        "baseline_ns",
        "approaches",
        "best_per_shape",
        "summary"
      ],
      "properties": {
        "heights": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "widths": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shape",
              "reason"
            ],
            "properties": {
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "[H, W]"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "baseline_ns": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "description": "baseline time per [height][width]; null = skipped"
        },
        "baseline_cores": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "description": "cores the baseline plan uses per [height][width] (structure.cores_used of tilize / untilize, the running cores of the layout choices); null = skipped"
        },
        "baseline_core_split": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "kernel changes: the baseline's core split per [height][width]: rows, or cols / 2d with row cores x column chunks ('2d 2x16'); null = skipped"
        },
        "approaches": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "overrides",
              "speedup",
              "worst",
              "best",
              "counts",
              "regressions",
              "grid",
              "hypothetical"
            ],
            "properties": {
              "overrides": {
                "type": "object"
              },
              "hypothetical": {
                "type": "boolean",
                "description": "a hypothetical design (not the factory's plan) at some shape"
              },
              "speedup": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "geomean",
                  "min",
                  "max"
                ],
                "properties": {
                  "geomean": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "worst": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "shape",
                  "speedup"
                ],
                "properties": {
                  "shape": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "[H, W]"
                  },
                  "speedup": {
                    "type": "number"
                  }
                }
              },
              "best": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "shape",
                  "speedup"
                ],
                "properties": {
                  "shape": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "[H, W]"
                  },
                  "speedup": {
                    "type": "number"
                  }
                }
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "faster",
                  "neutral",
                  "slower",
                  "invalid"
                ],
                "properties": {
                  "faster": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "neutral": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "slower": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "invalid": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "regressions": {
                "type": "array",
                "description": "up to 5 worst shapes below 1 - NOISE, slowest first",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "shape",
                    "speedup"
                  ],
                  "properties": {
                    "shape": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "[H, W]"
                    },
                    "speedup": {
                      "type": "number"
                    }
                  }
                }
              },
              "grid": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "description": "speedup vs baseline per [height][width]; null = skipped, not evaluated or invalid"
              },
              "cores": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "description": "cores the approach's plan uses per [height][width]; null = skipped, not evaluated or invalid"
              },
              "core_split": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "kernel changes: the approach's core split per [height][width] (rows, 'cols 8x4', '2d 2x16': row cores x column chunks)"
              },
              "wins_where": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the faster shapes as one grid rectangle, if they form one"
              },
              "loses_where": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the slower shapes as one grid rectangle, if they form one"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "kernel_change",
                  "layout_choice"
                ],
                "description": "kernel_change: a (hypothetical) change of the factory's kernels (tilize / untilize design knobs); layout_choice: a shard option of a sharding op or reshard (what the op, and the next op, receives; the pinned factories, never hypothetical)"
              },
              "factory": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the factory the approach runs at most shapes"
              },
              "factories": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                },
                "description": "layout choices running more than one factory across the grid: factory -> shapes"
              },
              "untimed": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "description": "layout choices: per [height][width], true = the comparison involves a side the profile does not time (ttsim-perf: DRAM; craq-sim: reshard bytes): the speedup is not meaningful; null = not evaluated or invalid"
              },
              "untimed_cells": {
                "type": "integer",
                "minimum": 0,
                "description": "layout choices: cells marked untimed"
              },
              "dram_capped": {
                "type": "integer",
                "minimum": 0,
                "description": "profiles with an assumed DRAM bandwidth (silicon-hypothesis): shapes where the DRAM bound sets the approach's time"
              },
              "scenario_speedups": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "description": "scenarios_checked: [low, high] cost-scenario speedups per [height][width] (low = the fast scenario); null = not evaluated or invalid"
              },
              "depends_on_scenario": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "description": "scenarios_checked: per [height][width], true = the low, nominal and high speedups fall on different sides of the NOISE band (the verdict depends on the cost scenario)"
              },
              "scenario_dependent_cells": {
                "type": "integer",
                "minimum": 0,
                "description": "scenarios_checked: cells marked depends_on_scenario"
              }
            }
          }
        },
        "best_per_shape": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "per [height][width]: \"baseline\" unless an approach is faster beyond NOISE; else, among the approaches within NOISE of the fastest, the one with the fewest overrides; null = skipped or not evaluated"
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "speedup_basis": {
          "type": "string"
        },
        "scenarios_checked": {
          "type": "boolean",
          "description": "true when the low / high cost scenarios were timed too (a profile with an assumed DRAM bandwidth whose scenarios differ: silicon-hypothesis); approaches then carry scenario_speedups, depends_on_scenario and scenario_dependent_cells"
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shapes": {
              "type": "integer"
            },
            "evaluated": {
              "type": "integer"
            },
            "skipped": {
              "type": "integer"
            },
            "not_evaluated": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "[H, W]"
              }
            },
            "plans_evaluated": {
              "type": "integer"
            },
            "plans_reused": {
              "type": "integer"
            },
            "approaches": {
              "type": "integer"
            },
            "out_of_time": {
              "type": "boolean"
            },
            "time_budget_s": {
              "type": "number"
            },
            "eval_ms": {
              "type": "number"
            },
            "outside_calibrated_range": {
              "type": "integer",
              "description": "evaluated shapes outside the calibrated range"
            }
          }
        },
        "outside_calibrated_range": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "description": "per [height][width]: true = an evaluated shape outside the factory's calibrated range on this profile (extrapolated)"
        },
        "calibrated_range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "max_h": {
              "type": "integer"
            },
            "max_w": {
              "type": "integer"
            },
            "max_elems": {
              "type": "integer"
            },
            "runs": {
              "type": "integer"
            },
            "profile": {
              "type": "string"
            }
          },
          "description": "the factory's calibrated shape range (largest rows, width, elements over its runs on profile)"
        },
        "compare": {
          "type": "object",
          "additionalProperties": false,
          "description": "survey.compare_profile: the same survey on another cost profile; per approach the speedup there",
          "required": [
            "profile",
            "status",
            "approaches",
            "summary"
          ],
          "properties": {
            "profile": {
              "$ref": "#/$defs/profile_id"
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "partial"
              ]
            },
            "platform_scope": {
              "type": "string"
            },
            "accuracy": {
              "type": "string"
            },
            "approaches": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "speedup",
                  "counts"
                ],
                "properties": {
                  "speedup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "geomean",
                      "min",
                      "max"
                    ],
                    "properties": {
                      "geomean": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "min": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "max": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "faster",
                      "neutral",
                      "slower",
                      "invalid"
                    ],
                    "properties": {
                      "faster": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "neutral": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "slower": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "invalid": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "worst": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "shape",
                      "speedup"
                    ],
                    "properties": {
                      "shape": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "description": "[H, W]"
                      },
                      "speedup": {
                        "type": "number"
                      }
                    }
                  },
                  "best": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "shape",
                      "speedup"
                    ],
                    "properties": {
                      "shape": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "description": "[H, W]"
                      },
                      "speedup": {
                        "type": "number"
                      }
                    }
                  },
                  "dram_capped": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "profiles with an assumed DRAM bandwidth (silicon-hypothesis): shapes where the DRAM bound sets the approach's time"
                  },
                  "untimed_cells": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "layout choices: cells marked untimed"
                  },
                  "scenario_dependent_cells": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "scenarios_checked on that profile: cells whose verdict depends on the cost scenario"
                  }
                }
              }
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stats": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evaluated": {
                  "type": "integer"
                },
                "skipped": {
                  "type": "integer"
                },
                "plans_evaluated": {
                  "type": "integer"
                },
                "eval_ms": {
                  "type": "number"
                },
                "outside_calibrated_range": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "kernel_change",
            "layout_choice"
          ],
          "description": "the survey's approach kind (see approaches.kind)"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "description": "the baseline across the evaluated shapes: its factory (at most shapes), factories and limiters (busiest role, or noc_l1_global / dram_global) with their shape counts; dram_capped on a profile with an assumed DRAM bandwidth, untimed for layout choices",
          "properties": {
            "factory": {
              "type": [
                "string",
                "null"
              ]
            },
            "factories": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "limiters": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "dram_capped": {
              "type": "integer",
              "minimum": 0
            },
            "untimed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "detail=full: every cost used, with value/low/high/class/source"
    },
    "resolved_input": {
      "type": "object"
    },
    "resolved_input_sha256": {
      "type": "string"
    }
  },
  "$defs": {
    "range3": {
      "type": "object",
      "required": [
        "nominal"
      ],
      "additionalProperties": false,
      "properties": {
        "nominal": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
